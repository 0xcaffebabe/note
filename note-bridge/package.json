  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
